generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  role      Role      @default(USER)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id         String   @id @default(cuid())
  name       String
  roomType   String
  purpose    String
  budget     Int      @default(250000)
  status     String   @default("Draft")
  compliant  Boolean  @default(false)
  layoutJson Json?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Equipment {
  id     String  @id
  name   String
  cat    String
  subcat String
  price  Int     @default(0)
  active Boolean @default(true)
}
